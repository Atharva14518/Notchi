# Copy to .dev.vars (ignored). Never commit real keys.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_BUCKET_SCOPED_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=YOUR_BUCKET_SCOPED_R2_SECRET
R2_BUCKET_NAME=notchi-private-files
# Each must be independent, random, at least 32 bytes (openssl rand -hex 32).
PASSWORD_PEPPER=REPLACE_WITH_RANDOM_SECRET
ABUSE_HASH_KEY=REPLACE_WITH_RANDOM_SECRET
# Local-only R2 emulation uses this independent signing secret.
LOCAL_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
DOWNLOAD_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
