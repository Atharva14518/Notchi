{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "notchi-links",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  // No request/response logging: paths and query strings contain bearer secrets.
  "observability": { "enabled": false },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "notchi-private-files", "preview_bucket_name": "notchi-private-files-preview" }],
  "triggers": { "crons": ["*/10 * * * *"] },
  "ratelimits": [
    { "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "AUTH_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "PUBLIC_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": { "PUBLIC_BASE_URL": "https://links.example.invalid", "PAID_MAX_BYTES": "1073741824", "PAID_MAX_LINKS": "50" }
}
